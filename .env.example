# Monevo configuration example. Copy to `.env` (production, next to docker-compose.yml) or
# `.env.development` (local development) and fill in the values.
# Every variable, its default, and its *_FILE variant: docs/infrastructure/configuration.md

# --- Required ---

# Public base URL. Must be https:// unless INSECURE_COOKIES=true.
# Local development: http://localhost:5173 (with INSECURE_COOKIES=true).
APP_URL=https://money.example.com

# 32 random bytes, base64, e.g. `openssl rand -base64 32`. Keep a copy outside the backups.
# Docker secrets: set APP_ENCRYPTION_KEY_FILE=/run/secrets/<name> instead.
APP_ENCRYPTION_KEY=

# External PostgreSQL (supported majors and TLS: docs/infrastructure/postgresql.md).
# Local development with docker-compose.dev.yml: postgresql://monevo:monevo@127.0.0.1:5432/monevo_dev
# Docker secrets: set DATABASE_URL_FILE=/run/secrets/<name> instead.
DATABASE_URL=postgresql://monevo:<password>@<db-host>:5432/monevo?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem

# Sign-in is OIDC-only through Account Center (docs/infrastructure/deployment.md#registering-monevo-in-account-center).
# Redirect URI to register: <APP_URL>/api/v1/auth/oidc/callback; post-logout redirect URI: <APP_URL>/login.
# Issuer must be https:// unless INSECURE_COOKIES=true.
# Local development with the mock-idp dev service: OIDC_ISSUER=http://localhost:9400,
# OIDC_CLIENT_ID=monevo-dev, OIDC_CLIENT_SECRET=monevo-dev-secret, OIDC_DISPLAY_NAME=Mock IdP
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=monevo
# Empty → public client (PKCE only). Docker secrets: set OIDC_CLIENT_SECRET_FILE=/run/secrets/<name> instead.
OIDC_CLIENT_SECRET=

# --- Optional (defaults shown) ---

# OIDC_SCOPES=openid profile email groups
# When set, members of this group (groups claim) are admins; otherwise the first user to sign in is.
# OIDC_ADMIN_GROUP=
# OIDC_DISPLAY_NAME=Account Center
# SESSION_IDLE_DAYS=30
# SESSION_ABSOLUTE_DAYS=90

# LOG_LEVEL=info
# DATABASE_POOL_SIZE=10
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Only for local development or a trusted LAN test over plain HTTP:
# INSECURE_COOKIES=false
# CORS_ALLOWED_ORIGINS=
# API_DOCS_ENABLED=true
# Normally the reverse proxy compresses responses:
# HTTP_COMPRESSION=false
